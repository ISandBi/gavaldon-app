<?xml version="1.0" encoding="utf-8"?>
<!-- Item activo: píldora Azul Confianza con icono y texto blancos (15.39:1) -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_checked="true">
        <inset android:insetLeft="6dp" android:insetTop="6dp" android:insetRight="6dp" android:insetBottom="6dp">
            <shape android:shape="rectangle">
                <solid android:color="@color/color_brand_primary" />
                <corners android:radius="16dp" />
            </shape>
        </inset>
    </item>
    <item>
        <shape android:shape="rectangle">
            <solid android:color="@android:color/transparent" />
        </shape>
    </item>
</selector>
