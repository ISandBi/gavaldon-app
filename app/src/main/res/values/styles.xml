<?xml version="1.0" encoding="utf-8"?>
<resources>

    <!-- ===== Botones (7.1) ===== -->
    <style name="Widget.Gavaldon.Button.Primary" parent="Widget.MaterialComponents.Button">
        <item name="backgroundTint">@color/selector_button_primary_bg</item>
        <item name="android:textColor">@color/selector_button_primary_text</item>
        <item name="iconTint">@color/selector_button_primary_text</item>
        <item name="android:minHeight">48dp</item>
        <item name="android:insetTop">0dp</item>
        <item name="android:insetBottom">0dp</item>
        <item name="cornerRadius">12dp</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textSize">16sp</item>
    </style>

    <style name="Widget.Gavaldon.Button.Secondary" parent="Widget.MaterialComponents.Button.OutlinedButton">
        <item name="android:textColor">@color/color_brand_primary</item>
        <item name="iconTint">@color/color_brand_primary</item>
        <item name="strokeColor">@color/color_brand_primary</item>
        <item name="strokeWidth">1.5dp</item>
        <item name="android:minHeight">48dp</item>
        <item name="android:insetTop">0dp</item>
        <item name="android:insetBottom">0dp</item>
        <item name="cornerRadius">12dp</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textSize">16sp</item>
    </style>

    <!-- ===== Campos de formulario (7.3) ===== -->
    <style name="Widget.Gavaldon.TextInputLayout" parent="Widget.MaterialComponents.TextInputLayout.OutlinedBox">
        <item name="boxStrokeColor">@color/selector_input_stroke</item>
        <item name="boxStrokeErrorColor">@color/color_state_error</item>
        <item name="boxStrokeWidth">1dp</item>
        <item name="boxStrokeWidthFocused">2dp</item>
        <item name="boxCornerRadiusTopStart">10dp</item>
        <item name="boxCornerRadiusTopEnd">10dp</item>
        <item name="boxCornerRadiusBottomStart">10dp</item>
        <item name="boxCornerRadiusBottomEnd">10dp</item>
        <item name="hintTextColor">@color/color_brand_primary</item>
        <item name="android:textColorHint">@color/color_text_body</item>
        <!-- 6.2: el texto del error va en Gris Asfalto; el rojo solo es borde -->
        <item name="errorTextColor">@color/color_text_body</item>
        <item name="helperTextTextColor">@color/color_text_body</item>
        <item name="prefixTextColor">@color/color_text_body</item>
        <item name="suffixTextColor">@color/color_text_body</item>
        <item name="endIconTint">@color/color_text_body</item>
    </style>

    <style name="Widget.Gavaldon.Card" parent="Widget.MaterialComponents.CardView">
        <item name="cardBackgroundColor">@color/color_surface_card</item>
        <item name="cardCornerRadius">14dp</item>
        <item name="cardElevation">2dp</item>
        <item name="strokeColor">@color/color_state_disabled_bg</item>
        <item name="strokeWidth">1dp</item>
    </style>

    <!-- ===== Tipografía (PEN-04 sin definir: fuente del sistema, tamaños en sp) ===== -->
    <style name="Text.Headline" parent="">
        <item name="android:textColor">@color/color_text_title</item>
        <item name="android:textSize">24sp</item>
        <item name="android:textStyle">bold</item>
    </style>
    <style name="Text.Title" parent="">
        <item name="android:textColor">@color/color_text_title</item>
        <item name="android:textSize">18sp</item>
        <item name="android:textStyle">bold</item>
    </style>
    <style name="Text.Body" parent="">
        <item name="android:textColor">@color/color_text_body</item>
        <item name="android:textSize">15sp</item>
    </style>
    <style name="Text.Caption" parent="">
        <item name="android:textColor">@color/color_text_body</item>
        <item name="android:textSize">13sp</item>
    </style>
    <style name="Text.OnDark" parent="">
        <item name="android:textColor">@color/color_text_on_dark</item>
        <item name="android:textSize">15sp</item>
    </style>

    <!-- Etiqueta "Estación seleccionada": borde naranja + texto (7.2, no depende solo del color) -->
    <style name="Text.SelectedLabel" parent="Text.Caption">
        <item name="android:textColor">@color/color_text_title</item>
        <item name="android:textStyle">bold</item>
        <item name="android:background">@drawable/bg_label_selected</item>
        <item name="android:paddingStart">10dp</item>
        <item name="android:paddingEnd">10dp</item>
        <item name="android:paddingTop">4dp</item>
        <item name="android:paddingBottom">4dp</item>
    </style>
</resources>
